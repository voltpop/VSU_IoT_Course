#!/bin/sh
# Auto-bump VoltPop's submodule pin whenever this repo's main branch advances
# (fires after `git merge` / the merge step of `git pull`).
#
# Requires, once per clone:
#   git config core.hooksPath "$(git rev-parse --show-toplevel)/.githooks"
# MUST be an absolute path — a relative one (e.g. plain ".githooks") resolves
# against $GIT_DIR, which for a submodule is the nested .git/modules/... path,
# not this working tree, so git silently never finds the hook at all.
# See Repo-Architecture-Master-Scoped-KBs.md in VoltPop's AI/Local/ for why
# this isn't automatic, and the full submodule process guide in general.

SUPER_ROOT=$(git rev-parse --show-superproject-working-tree 2>/dev/null)
if [ -z "$SUPER_ROOT" ]; then
  # Not being used as a submodule right now — nothing to bump.
  exit 0
fi

SUBMODULE_PATH=$(git rev-parse --show-toplevel)

# Must unset these: they're inherited from the invoking git process (pointing
# at THIS submodule's git dir), and would otherwise silently override the cd
# below, making every subsequent git command still operate on the submodule
# instead of VoltPop. (Confirmed by testing: without this, "git commit"
# reported success but never actually landed a commit in VoltPop.)
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

cd "$SUPER_ROOT" || exit 0
git pull --ff-only origin main >/dev/null 2>&1

git add "$SUBMODULE_PATH"
if git commit -m "Bump VSU_IoT_Course submodule to latest main (auto)" --quiet; then
  if git push origin main --quiet 2>/dev/null; then
    echo "VoltPop: auto-bumped VSU_IoT_Course submodule pin and pushed." >&2
  else
    echo "VoltPop: auto-bumped VSU_IoT_Course submodule pin locally, but push failed — push VoltPop's main manually." >&2
  fi
fi
